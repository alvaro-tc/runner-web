# URL base de la API. Vacio = mismo dominio (/api/v1) en produccion y
# http://localhost:3000/api/v1 en desarrollo.
# VITE_API_BASE_URL=https://cam-run.tumype.com/api/v1

# ID del cliente Web de Google (el mismo que GOOGLE_CLIENT_IDS en la API).
# Sin el, el boton "Continuar con Google" no aparece.
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
